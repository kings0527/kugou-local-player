<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp">

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 唱片：黑盘 + 圆形封面 + 中心孔，整体旋转 -->
        <FrameLayout
            android:id="@+id/pvDiscWrap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3.2"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/pvDisc"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/pvArt"
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.LeLing.Circle" />

                <TextView
                    android:id="@+id/pvArtLetter"
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_thumb"
                    android:gravity="center"
                    android:textColor="@color/placeholder_fg"
                    android:textSize="72sp"
                    android:textStyle="bold"
                    tools:text="♪" />

                <!-- 中心孔 -->
                <View
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_center_hole" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/pvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/player_placeholder_title"
            android:textColor="@color/player_text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pvArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/player_placeholder_sub"
            android:textColor="@color/player_text_dim"
            android:textSize="15sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 进度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pvCur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/player_text_dim"
                android:textSize="12sp"
                tools:text="1:23" />

            <SeekBar
                android:id="@+id/pvSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="@color/brand_primary"
                android:thumbTint="@color/player_text" />

            <TextView
                android:id="@+id/pvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/player_text_dim"
                android:textSize="12sp"
                tools:text="4:29" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="0.6" />

        <!-- 控制 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/pvShuffle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_shuffle"
                app:srcCompat="@drawable/ic_shuffle"
                app:tint="@color/player_icon_dim" />

            <ImageButton
                android:id="@+id/pvPrev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_prev"
                app:srcCompat="@drawable/ic_prev"
                app:tint="@color/player_text" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.35">

                <ImageButton
                    android:id="@+id/pvPlay"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_play"
                    android:contentDescription="@string/cd_play_pause"
                    android:scaleType="centerInside"
                    android:padding="20dp"
                    app:srcCompat="@drawable/ic_play"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/pvNext"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_next"
                app:srcCompat="@drawable/ic_next"
                app:tint="@color/player_text" />

            <ImageButton
                android:id="@+id/pvRepeat"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_repeat"
                app:srcCompat="@drawable/ic_repeat"
                app:tint="@color/player_icon_dim" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1.1" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/pvBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close"
        app:srcCompat="@drawable/ic_arrow_back"
        app:tint="@color/player_text" />
</FrameLayout>
