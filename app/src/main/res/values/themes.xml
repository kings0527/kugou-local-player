<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LeLing" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorSurface">@android:color/transparent</item>
    </style>
    <style name="Theme.LeLing.Player" parent="Theme.LeLing">
        <item name="android:windowBackground">@color/player_bg</item>
        <item name="android:statusBarColor">@color/player_bg</item>
        <item name="android:navigationBarColor">@color/player_bg</item>
    </style>

    <!-- 圆形图片裁剪（唱片封面） -->
    <style name="ShapeAppearance.LeLing.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
